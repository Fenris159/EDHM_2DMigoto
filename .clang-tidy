---
# Parser switches use explicit fallback code after the switch, and duplicate
# case bodies intentionally share grammar actions. Exported Windows ABI names
# and imported SDK conventions intentionally use leading underscores.
# Token-pasting declaration macros cannot parenthesize generated identifiers.
# Pointer-keyed iterations perform only commutative sums or order-independent
# erasure, so their order is intentionally irrelevant.
Checks: >
  -*,
  clang-analyzer-*,
  -clang-analyzer-optin.core.EnumCastOutOfRange,
  bugprone-*,
  -bugprone-branch-clone,
  -bugprone-easily-swappable-parameters,
  -bugprone-exception-escape,
  -bugprone-reserved-identifier,
  -bugprone-signed-bitwise,
  -bugprone-switch-missing-default-case,
  -bugprone-suspicious-semicolon,
  -bugprone-throwing-static-initialization,
  -bugprone-unhandled-code-paths,
  -bugprone-macro-parentheses,
  -bugprone-nondeterministic-pointer-iteration-order,
  cert-err58-cpp,
  -cert-err58-cpp,
  cert-oop11-cpp,
  cppcoreguidelines-pro-type-member-init,
  misc-misplaced-const,
  misc-new-delete-overloads,
  misc-redundant-expression,
  modernize-use-nullptr,
  modernize-use-override,
  performance-*,
  -performance-enum-size,
  -performance-no-int-to-ptr,
  -performance-unnecessary-value-param,
  portability-*,
  readability-container-size-empty,
  readability-delete-null-pointer,
  readability-redundant-*,
  -readability-redundant-parentheses,
WarningsAsErrors: >
  clang-analyzer-*,
  bugprone-*,
  cert-*,
  performance-*,
  portability-*
HeaderFilterRegex: '^(?!.*[\\/](DirectXTK|vendor|pcre2|Nektra|crc32c-hw-1\.0\.5)[\\/]).*$'
SystemHeaders: false
FormatStyle: file
CheckOptions:
  bugprone-narrowing-conversions.WarnOnIntegerToFloatingPointNarrowingConversion: false
...
